# Copy this file to ".env" and fill in the values.

# Port the backend server runs on.
PORT=3001

# Your MongoDB connection string.
# For a local MongoDB use: mongodb://127.0.0.1:27017/docappointment
# For MongoDB Atlas paste the connection string they give you.
MONGO_URI=mongodb://127.0.0.1:27017/docappointment

# Secret key used to sign the JWT login tokens. Change it to anything you like.
JWT_SECRET=mysecretkey123
