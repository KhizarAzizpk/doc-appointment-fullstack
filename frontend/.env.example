# Copy this file to ".env" ONLY if you need to change the backend URL.
# On your own computer you don't need this file at all - the app defaults
# to http://localhost:3001/api.
#
# When you deploy, set this to your live backend URL, for example:
# REACT_APP_API_URL=https://your-backend.onrender.com/api
REACT_APP_API_URL=http://localhost:3001/api
